{
  "$defs": {
    "BundleSource": {
      "additionalProperties": true,
      "description": "Where the bundled data came from.",
      "properties": {
        "catalog": {
          "description": "The catalogue location the bundle was exported from.",
          "title": "Catalog",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The catalogue release or commit the exporter named, as given.",
          "title": "Revision"
        },
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "catalog_descriptor_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Descriptor Sha256"
        }
      },
      "required": [
        "catalog"
      ],
      "title": "BundleSource",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A copy of catalogue data exported into a repository.",
  "properties": {
    "format": {
      "const": "ethos-data-bundle-v1",
      "default": "ethos-data-bundle-v1",
      "title": "Format",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/BundleSource"
    },
    "datasets": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "Dataset name to its descriptor, resources included.",
      "title": "Datasets",
      "type": "object"
    },
    "collections": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Collection name to the resource keys it bundles, sidecars included.",
      "title": "Collections",
      "type": "object"
    }
  },
  "required": [
    "source",
    "datasets",
    "collections"
  ],
  "title": "bundle.json",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
